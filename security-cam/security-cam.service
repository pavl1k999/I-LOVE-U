# Linux (systemd, пользовательский сервис):
#   mkdir -p ~/.config/systemd/user
#   cp security-cam.service ~/.config/systemd/user/
#   (поправьте путь в ExecStart)
#   systemctl --user enable --now security-cam
[Unit]
Description=Security Cam recorder

[Service]
ExecStart=/usr/bin/python3 %h/security-cam/security_cam.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
